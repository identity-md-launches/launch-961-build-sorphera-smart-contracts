{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized isolated Sepolia canary inputs; external filled configuration only",
  "type": "object",
  "required": ["chainId", "rpcUrl", "sender", "signerRpc", "dedicatedSender", "confirmations", "maxGas", "maxFeePerGas", "maxTxCost", "maxTotalCost", "minimumBalance", "subscriptionMinimum", "requestConfirmations", "callbackGas", "nativePayment"],
  "properties": {
    "chainId": {"const": 11155111},
    "coordinator": {"const": "0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B"},
    "keyHash": {"const": "0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae"},
    "rpcUrl": {"type": "string", "format": "uri"},
    "sender": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "not": {"const": "0x0000000000000000000000000000000000000000"}},
    "signerRpc": {"type": "string", "format": "uri"},
    "signerMethod": {"const": "account_signTransaction"},
    "dedicatedSender": {"const": true},
    "localFork": {"const": false},
    "subscription": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$", "description": "Null creates a new company test subscription; otherwise supply the company's existing ID."},
    "nativePayment": {"type": "boolean"},
    "nativeTopUpWei": {"type": ["string", "integer"], "pattern": "^[0-9]+$", "minimum": 0},
    "subscriptionMinimum": {"$ref": "#/$defs/amount"},
    "confirmations": {"type": "integer", "minimum": 1},
    "requestConfirmations": {"type": "integer", "minimum": 3, "maximum": 200},
    "callbackGas": {"type": "integer", "minimum": 150000, "maximum": 2500000},
    "maxGas": {"type": "integer", "minimum": 21000},
    "maxFeePerGas": {"$ref": "#/$defs/amount"},
    "maxTxCost": {"$ref": "#/$defs/amount"},
    "maxTotalCost": {"$ref": "#/$defs/amount"},
    "minimumBalance": {"$ref": "#/$defs/amount"},
    "ticketPriceWei": {"type": "integer", "minimum": 10, "maximum": 1000000000000, "multipleOf": 10},
    "cutoffDelaySeconds": {"type": "integer", "minimum": 7200, "maximum": 604800}
  },
  "$defs": {"amount": {"type": "string", "pattern": "^[1-9][0-9]*$"}}
}
