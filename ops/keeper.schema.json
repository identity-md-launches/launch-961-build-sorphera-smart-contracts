{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sorphera keeper operational configuration; null example values require operator input",
  "type": "object",
  "required": ["rpcUrl", "chainId", "sender", "lottery", "deploymentBlock", "confirmations", "maxGas", "maxFeePerGas", "maxTxCost", "maxTotalCost", "minimumBalance", "minimumVRFBalance"],
  "properties": {
    "rpcUrl": {"type": "string", "format": "uri"},
    "chainId": {"enum": [1, 11155111, 31337]},
    "sender": {"$ref": "#/$defs/address"},
    "lottery": {"$ref": "#/$defs/address"},
    "deploymentBlock": {"type": "integer", "minimum": 0},
    "signerRpc": {"type": ["string", "null"]},
    "signerMethod": {"enum": ["account_signTransaction", "eth_signTransaction"]},
    "dedicatedSender": {"type": "boolean"},
    "localFork": {"type": "boolean"},
    "confirmations": {"type": "integer", "minimum": 1},
    "maxGas": {"type": "integer", "minimum": 21000},
    "maxFeePerGas": {"$ref": "#/$defs/amount"},
    "maxTxCost": {"$ref": "#/$defs/amount"},
    "maxTotalCost": {"$ref": "#/$defs/amount"},
    "minimumBalance": {"$ref": "#/$defs/amount"},
    "minimumVRFBalance": {"$ref": "#/$defs/amount"},
    "pollSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "logBlockBatch": {"type": "integer", "minimum": 1, "maximum": 2000},
    "acquisitionBatch": {"type": "integer", "minimum": 1, "maximum": 8},
    "acquire": {"type": "boolean"},
    "openRounds": {"type": "boolean"}
  },
  "$defs": {
    "amount": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "not": {"const": "0x0000000000000000000000000000000000000000"}}
  }
}
